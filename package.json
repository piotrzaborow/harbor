{
  "name": "harbor",
  "module": "src/index.tsx",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "bun test",
    "test:e2e": "bun test tests/e2e.test.ts",
    "dev": "bun run --watch src/index.tsx",
    "build": "bun build src/index.tsx --compile --minify --sourcemap --outfile dist/harbor",
    "build:mac:arm": "bun build src/index.tsx --compile --minify --sourcemap --target=bun-darwin-arm64 --outfile dist/harbor-mac-arm",
    "build:mac:x64": "bun build src/index.tsx --compile --minify --sourcemap --target=bun-darwin-x64 --outfile dist/harbor-mac-x64",
    "build:ubuntu:arm": "bun build src/index.tsx --compile --minify --sourcemap --target=bun-linux-arm64 --outfile dist/harbor-linux-arm",
    "build:ubuntu:x64": "bun build src/index.tsx --compile --minify --sourcemap --target=bun-linux-x64 --outfile dist/harbor-linux-x64",
    "build:windows:arm": "bun build src/index.tsx --compile --minify --sourcemap --target=bun-windows-arm64 --outfile dist/harbor-windows-arm",
    "build:windows:x64": "bun build src/index.tsx --compile --minify --sourcemap --target=bun-windows-x64 --outfile dist/harbor-windows-x64"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.18"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@opentui/core": "^0.5.1",
    "@opentui/react": "^0.5.1",
    "fast-xml-parser": "^5.10.1",
    "react": "^19.2.6"
  },
  "optionalDependencies": {
    "@opentui/core-linux-arm64-musl": "^0.5.1",
    "@opentui/core-linux-x64-musl": "^0.5.1",
    "@opentui/core-darwin-arm64": "^0.5.1",
    "@opentui/core-darwin-x64": "^0.5.1",
    "@opentui/core-windows-arm64": "^0.5.1",
    "@opentui/core-windows-x64": "^0.5.1"
  }
}