{
  "name": "laneway",
  "version": "1.0.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piotrzaborow/laneway.git"
  },
  "license": "AGPL-3.0",
  "module": "src/index.tsx",
  "type": "module",
  "bin": {
    "laneway": "dist/laneway"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "bun run build && sudo ./dist/laneway",
    "test": "bun test",
    "test:e2e": "bun test tests/e2e.test.ts",
    "dev": "bun run --watch src/index.tsx",
    "build": "bun build src/index.tsx --compile --minify --sourcemap --target node --outfile dist/laneway"
  },
  "devDependencies": {
    "@opentui/core-darwin-arm64": "0.5.1",
    "@opentui/core-darwin-x64": "0.5.1",
    "@opentui/core-linux-arm64": "0.5.1",
    "@opentui/core-linux-x64": "0.5.1",
    "@opentui/core-win32-arm64": "0.5.1",
    "@opentui/core-win32-x64": "0.5.1",
    "@types/bun": "latest",
    "@types/react": "^19.2.18"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@opentui/core": "^0.5.1",
    "@opentui/react": "^0.5.1",
    "fast-xml-parser": "^5.10.1",
    "react": "^19.2.8"
  }
}