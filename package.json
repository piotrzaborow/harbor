{
  "name": "laneway",
  "version": "1.0.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piotrzaborow/laneway.git"
  },
  "license": "AGPL-3.0",
  "module": "src/index.tsx",
  "type": "module",
  "bin": {
    "laneway": "./bin/index.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "start": "bun run build && sudo ./dist/laneway",
    "test": "bun test",
    "test:e2e": "bun test tests/e2e.test.ts",
    "dev": "bun run --watch src/index.tsx",
    "build": "bun build src/index.tsx --compile --minify --outfile dist/laneway",
    "build:darwin:arm64": "bun build src/index.tsx --compile --minify --target=bun-darwin-arm64 --outfile dist/laneway-darwin-arm64",
    "build:darwin:x64": "bun build src/index.tsx --compile --minify --target=bun-darwin-x64 --outfile dist/laneway-darwin-x64",
    "build:linux:arm64": "bun build src/index.tsx --compile --minify --target=bun-linux-arm64 --outfile dist/laneway-linux-arm64",
    "build:linux:x64": "bun build src/index.tsx --compile --minify --target=bun-linux-x64 --outfile dist/laneway-linux-x64",
    "build:windows:arm64": "bun build src/index.tsx --compile --minify --target=bun-windows-arm64 --outfile dist/laneway-windows-arm64.exe",
    "build:windows:x64": "bun build src/index.tsx --compile --minify --target=bun-windows-x64 --outfile dist/laneway-windows-x64.exe"
  },
  "devDependencies": {
    "@opentui/core-darwin-arm64": "0.5.1",
    "@opentui/core-darwin-x64": "0.5.1",
    "@opentui/core-linux-arm64": "0.5.1",
    "@opentui/core-linux-x64": "0.5.1",
    "@opentui/core-win32-arm64": "0.5.1",
    "@opentui/core-win32-x64": "0.5.1",
    "@types/bun": "latest",
    "@types/react": "^19.2.18"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@opentui/core": "^0.5.1",
    "@opentui/react": "^0.5.1",
    "fast-xml-parser": "^5.10.1",
    "react": "^19.2.6"
  }
}